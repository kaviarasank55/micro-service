

spring:
  application:
    name: api-gateway
  cloud:
    gateway:
      routes:
        - id: service-1
          uri: lb://service-1
          predicates:
            - Path=/service1/api/**
        - id: service-2
          uri: lb://service-2
          predicates:
            - Path=/service2/**
      consul:
        discovery:
          enabled: true
          register: true
server:
  port: 9090